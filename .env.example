# Run: uv run python scripts/init_env.py --site-url https://your-own-domain.example
ENVIRONMENT=production
SITE_URL=http://localhost:8788
DATABASE_URL=sqlite:///./data/studio.db
DATA_DIR=./data
STUDIO_PASSWORD=
ENCRYPTION_KEY=
SESSION_SECRET=
# Browser session lifetime in seconds. Omit for the 12 hour default (43200).
# Finite bound: 60..2592000. A 30 day tailnet deployment sets:
# SESSION_TTL_SECONDS=2592000
STUDIO_API_TOKEN=
GPU_AGENT_TOKEN=
GPU_AGENT_OWNER_ID=owner
GPU_ENABLED=1
GPU_REAL_ENABLED=0
# Official Colab CLI slice. off does not call colab. fake requires COLAB_CLI_BIN
# pointing at a local stand-in. real also needs COLAB_CLI_ALLOW_REAL=1 and
# GPU_REAL_ENABLED=1, and is Linux/macOS only. Never set real in tests.
COLAB_CLI_MODE=off
COLAB_CLI_BIN=
COLAB_CLI_ALLOW_REAL=0
# Optional public OAuth client file for the CLI. Not read by the web UI.
# COLAB_CLI_OAUTH_CONFIG=
GPU_STORAGE=local
GPU_MAX_RUNTIME_MINUTES=30
GPU_DAILY_UNITS=10
GPU_MONTHLY_UNITS=100
GPU_MAX_JOB_UNITS=5
# compute units PER MINUTE, administrator estimate, never advertised as actual billing
GPU_UNIT_RATE=
GPU_CREATE_RETRIES=2
GPU_CREATE_TIMEOUT_SECONDS=30
GPU_GOOGLE_CLIENT_ID=
GPU_GOOGLE_CLIENT_SECRET=
GPU_GOOGLE_REDIRECT_URI=
BIND_IP=127.0.0.1
BIND_PORT=8788
